# Copy this file to .env. Keep your API key on the server.
# Without a key, the application uses a transparent local scoring algorithm.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PORT=8000

# Optional custom AI service instead of Gemini (see README).
# CQ_AI_URL=http://127.0.0.1:9000/recommend
# CQ_AI_TOKEN=
