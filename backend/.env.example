# Generate your own URL-safe secrets. No working credentials are included.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://career_quest:YOUR_URL_SAFE_PASSWORD@localhost:5432/career_quest
ENVIRONMENT=development
DEMO_AUTH=true
DEMO_SEED=false
DEMO_PASSWORD=
BUSINESS_DATE=2026-10-01
TOKEN_HOURS=8
CORS_ORIGINS=["http://localhost:5173"]
# Leave LLM_ENDPOINT unset for deterministic local recommendations.
# LLM_ENDPOINT=http://127.0.0.1:1234/v1
LLM_MODEL=local-model
# Set json_schema for services supporting constrained structured output.
LLM_RESPONSE_FORMAT=json_object
ALLOW_EXTERNAL_AI=false
LLM_TIMEOUT_SECONDS=3
