# TEMPLATE ONLY: replace password placeholders before running locally.
# Copy to backend/.env on a fresh checkout. Do not overwrite existing settings.
POSTGRES_PASSWORD=YOUR_URL_SAFE_PASSWORD
DATABASE_URL=postgresql+asyncpg://career_quest:YOUR_URL_SAFE_PASSWORD@localhost:5432/career_quest
ENVIRONMENT=development
DEMO_AUTH=true
