CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LLM_MODEL=local-model
LLM_RESPONSE_FORMAT=json_object
ALLOW_EXTERNAL_AI=false
LLM_TIMEOUT_SECONDS=3
